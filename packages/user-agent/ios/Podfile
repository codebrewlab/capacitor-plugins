platform :ios, '15.0'

# npm workspace 는 @capacitor/ios 를 레포 루트로 hoist 하기도 하고 패키지 하위에
# nested 로 두기도 한다 (Capacitor 8 부터 nested 로 떨어진다). 두 배치 모두에서
# 검증 빌드가 돌게 실제 존재하는 경로를 찾아 쓴다.
CAPACITOR_IOS_PATH = [
  '../node_modules/@capacitor/ios',
  '../../../node_modules/@capacitor/ios',
].find { |path| File.directory?(File.join(__dir__, path)) } ||
  raise('@capacitor/ios 를 찾을 수 없습니다. npm install 을 먼저 실행하세요.')

def capacitor_pods
  # Comment the next line if you're not using Swift and don't want to use dynamic frameworks
  use_frameworks!
  pod 'Capacitor', :path => CAPACITOR_IOS_PATH
  pod 'CapacitorCordova', :path => CAPACITOR_IOS_PATH
end

target 'Plugin' do
  capacitor_pods
end

target 'PluginTests' do
  capacitor_pods
end
